{
  "manifest_version": 3,
  "name": "OAuth Assist for HA",
  "version": "0.1.0",
  "description": "Captures mobile-app OAuth redirects (custom-scheme URLs) and forwards the authorization code to Home Assistant's official redirect service.",
  "permissions": ["webNavigation", "tabs", "storage", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OAuth Assist for HA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b42064e4-e994-41a7-9744-588574f0ce4d}",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
